{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":37484}],"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import argparse\nimport json\nimport os\nimport time\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.metrics import (classification_report, confusion_matrix,\n                             f1_score, accuracy_score, balanced_accuracy_score,\n                             roc_auc_score)\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.utils.class_weight import compute_class_weight\n\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\n\nCLASS_NAMES = [\"N\", \"S\", \"V\", \"F\", \"Q\"]  # label 0..4 (standar AAMI)\nSEED = 42\n\n\n# ----------------------------------------------------------------------------\n# 1. DATA\n# ----------------------------------------------------------------------------\ndef load_data(data_dir):\n    tr = pd.read_csv(os.path.join(data_dir, \"mitbih_train.csv\"), header=None)\n    te = pd.read_csv(os.path.join(data_dir, \"mitbih_test.csv\"), header=None)\n    df = pd.concat([tr, te], ignore_index=True)\n    X = df.iloc[:, :187].values.astype(\"float32\")\n    y = df.iloc[:, 187].values.astype(\"int64\")\n    return X, y\n\n\ndef make_synthetic(n=6000, seed=SEED):\n    rng = np.random.default_rng(seed)\n    probs = np.array([0.83, 0.03, 0.07, 0.01, 0.06])\n    y = rng.choice(5, size=n, p=probs)\n    t = np.linspace(0, 1, 187)\n    X = np.zeros((n, 187), dtype=\"float32\")\n    for i, c in enumerate(y):\n        centre = 0.25 + 0.05 * c\n        X[i] = np.exp(-((t - centre) ** 2) / (2 * (0.02 + 0.005 * c) ** 2))\n        X[i] += 0.15 * np.exp(-((t - 0.55) ** 2) / (2 * 0.05 ** 2))\n        X[i] += rng.normal(0, 0.03, 187)\n        X[i] = (X[i] - X[i].min()) / (X[i].max() - X[i].min() + 1e-8)\n    return X, y\n\n\ndef split_data(X, y, seed=SEED):\n    X_tr, X_tmp, y_tr, y_tmp = train_test_split(\n        X, y, test_size=0.30, stratify=y, random_state=seed)\n    X_va, X_te, y_va, y_te = train_test_split(\n        X_tmp, y_tmp, test_size=0.50, stratify=y_tmp, random_state=seed)\n    return X_tr, X_va, X_te, y_tr, y_va, y_te\n\n\n# ----------------------------------------------------------------------------\n# 2. MODEL\n# ----------------------------------------------------------------------------\ndef build_cnn(n_classes=5):\n    inp = keras.Input(shape=(187, 1))\n    x = layers.Conv1D(32, 5, padding=\"same\", activation=\"relu\")(inp)\n    x = layers.BatchNormalization()(x)\n    x = layers.MaxPooling1D(2)(x)\n    x = layers.Conv1D(64, 5, padding=\"same\", activation=\"relu\")(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.MaxPooling1D(2)(x)\n    x = layers.Conv1D(128, 3, padding=\"same\", activation=\"relu\")(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.GlobalAveragePooling1D()(x)\n    x = layers.Dense(64, activation=\"relu\")(x)\n    x = layers.Dropout(0.3)(x)\n    out = layers.Dense(n_classes, activation=\"softmax\")(x)\n    return keras.Model(inp, out, name=\"cnn1d\")\n\n\ndef build_lstm(n_classes=5):\n    inp = keras.Input(shape=(187, 1))\n    x = layers.LSTM(64, return_sequences=True)(inp)\n    x = layers.LSTM(32)(x)\n    x = layers.Dense(64, activation=\"relu\")(x)\n    x = layers.Dropout(0.3)(x)\n    out = layers.Dense(n_classes, activation=\"softmax\")(x)\n    return keras.Model(inp, out, name=\"lstm\")\n\n\n# ----------------------------------------------------------------------------\n# 3. TRAINING\n# ----------------------------------------------------------------------------\ndef train_model(model, data, class_weight, epochs, batch_size, out_dir):\n    X_tr, X_va, y_tr, y_va = data\n    model.compile(optimizer=keras.optimizers.Adam(1e-3, clipnorm=1.0),\n                  loss=\"sparse_categorical_crossentropy\",\n                  metrics=[\"accuracy\"])\n    cbs = [\n        keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=15,\n                                      restore_best_weights=True),\n        keras.callbacks.ReduceLROnPlateau(monitor=\"val_loss\", factor=0.5,\n                                          patience=5, min_lr=1e-5),\n    ]\n    t0 = time.time()\n    hist = model.fit(X_tr[..., None], y_tr,\n                     validation_data=(X_va[..., None], y_va),\n                     epochs=epochs, batch_size=batch_size,\n                     class_weight=class_weight, callbacks=cbs, verbose=2)\n    train_time = time.time() - t0\n    pd.DataFrame(hist.history).to_csv(\n        os.path.join(out_dir, f\"history_{model.name}.csv\"), index=False)\n    model.save(os.path.join(out_dir, f\"model_{model.name}.keras\"))\n    return hist.history, train_time\n\ndef plot_history(hist, name, out_dir):\n    fig, ax = plt.subplots(1, 2, figsize=(10, 3.6))\n    ax[0].plot(hist[\"loss\"], label=\"train\")\n    ax[0].plot(hist[\"val_loss\"], label=\"validation\")\n    ax[0].set_title(f\"{name}: loss\"); ax[0].set_xlabel(\"epoch\"); ax[0].legend()\n    ax[1].plot(hist[\"accuracy\"], label=\"train\")\n    ax[1].plot(hist[\"val_accuracy\"], label=\"validation\")\n    ax[1].set_title(f\"{name}: accuracy\"); ax[1].set_xlabel(\"epoch\"); ax[1].legend()\n    fig.tight_layout()\n    fig.savefig(os.path.join(out_dir, f\"fig_training_{name}.png\"), dpi=200)\n    plt.close(fig)\n\n\n# ----------------------------------------------------------------------------\n# 4. EVALUASI\n# ----------------------------------------------------------------------------\ndef evaluate(model, X_te, y_te, out_dir):\n    t0 = time.time()\n    proba = model.predict(X_te[..., None], verbose=0)\n    infer_ms = (time.time() - t0) / len(X_te) * 1000\n    pred = proba.argmax(1)\n    labels = list(range(5))\n\n    rep = classification_report(y_te, pred, labels=labels,\n                                target_names=CLASS_NAMES, output_dict=True,\n                                zero_division=0)\n    pd.DataFrame(rep).T.to_csv(\n        os.path.join(out_dir, f\"report_{model.name}.csv\"))\n\n    present = sorted(set(y_te))\n    try:\n        auc = roc_auc_score(y_te, proba, multi_class=\"ovr\", average=\"macro\",\n                            labels=labels) if len(present) == 5 else float(\"nan\")\n    except ValueError:\n        auc = float(\"nan\")\n\n    summary = {\n        \"model\": model.name,\n        \"params\": int(model.count_params()),\n        \"accuracy\": accuracy_score(y_te, pred),\n        \"balanced_accuracy\": balanced_accuracy_score(y_te, pred),\n        \"macro_f1\": f1_score(y_te, pred, average=\"macro\", zero_division=0),\n        \"weighted_f1\": f1_score(y_te, pred, average=\"weighted\", zero_division=0),\n        \"roc_auc_ovr_macro\": auc,\n        \"inference_ms_per_sample\": infer_ms,\n    }\n\n    cm = confusion_matrix(y_te, pred, labels=labels)\n    fig, ax = plt.subplots(1, 2, figsize=(11, 4.2))\n    sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", ax=ax[0],\n                xticklabels=CLASS_NAMES, yticklabels=CLASS_NAMES)\n    ax[0].set_title(f\"{model.name}: confusion matrix (jumlah)\")\n    cmn = cm / cm.sum(1, keepdims=True).clip(min=1)\n    sns.heatmap(cmn, annot=True, fmt=\".2f\", cmap=\"Blues\", vmin=0, vmax=1,\n                ax=ax[1], xticklabels=CLASS_NAMES, yticklabels=CLASS_NAMES)\n    ax[1].set_title(f\"{model.name}: confusion matrix (dinormalisasi per baris)\")\n    for a in ax:\n        a.set_xlabel(\"prediksi\"); a.set_ylabel(\"sebenarnya\")\n    fig.tight_layout()\n    fig.savefig(os.path.join(out_dir, f\"fig_confusion_{model.name}.png\"), dpi=200)\n    plt.close(fig)\n    return summary, pred, proba, cm\n\n\n# ----------------------------------------------------------------------------\n# 5. ERROR ANALYSIS\n# ----------------------------------------------------------------------------\ndef error_analysis(name, X_te, y_te, pred, proba, out_dir, per_pair=3):\n    wrong = np.where(pred != y_te)[0]\n    err = pd.DataFrame({\n        \"idx_test\": wrong,\n        \"true\": [CLASS_NAMES[i] for i in y_te[wrong]],\n        \"pred\": [CLASS_NAMES[i] for i in pred[wrong]],\n        \"conf_pred\": proba[wrong, pred[wrong]],\n        \"prob_true_class\": proba[wrong, y_te[wrong]],\n        \"n_zero_tail\": [int((X_te[i][::-1] == 0).argmin()) for i in wrong],\n    })\n    err.to_csv(os.path.join(out_dir, f\"errors_{name}.csv\"), index=False)\n\n    pairs = (err.groupby([\"true\", \"pred\"]).size()\n             .sort_values(ascending=False).head(3).reset_index(name=\"n\"))\n    pairs.to_csv(os.path.join(out_dir, f\"top_confusions_{name}.csv\"), index=False)\n\n    if len(pairs):\n        fig, axes = plt.subplots(len(pairs), per_pair,\n                                 figsize=(4 * per_pair, 2.6 * len(pairs)),\n                                 squeeze=False)\n        for r, (_, row) in enumerate(pairs.iterrows()):\n            sub = err[(err.true == row.true) & (err.pred == row.pred)]\n            sub = sub.sample(min(per_pair, len(sub)), random_state=SEED)\n            for c in range(per_pair):\n                ax = axes[r, c]\n                if c < len(sub):\n                    s = sub.iloc[c]\n                    ax.plot(X_te[int(s.idx_test)], lw=1)\n                    ax.set_title(f\"asli {s.true} → prediksi {s.pred} \"\n                                 f\"(p={s.conf_pred:.2f})\", fontsize=9)\n                ax.set_xticks([]); ax.set_yticks([])\n        fig.suptitle(f\"{name}: contoh prediksi salah pada pasangan kelas terbanyak\")\n        fig.tight_layout()\n        fig.savefig(os.path.join(out_dir, f\"fig_errors_{name}.png\"), dpi=200)\n        plt.close(fig)\n    return err, pairs\n\n\n# ----------------------------------------------------------------------------\n# MAIN\n# ----------------------------------------------------------------------------\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--data_dir\", default=\"./data\")\n    ap.add_argument(\"--out_dir\", default=\"./hasil\")\n    ap.add_argument(\"--epochs\", type=int, default=50)\n    ap.add_argument(\"--batch_size\", type=int, default=128)\n    ap.add_argument(\"--smoke\", action=\"store_true\",\n                    help=\"pakai data sintetis untuk uji cepat\")\n    args = ap.parse_args([\n    \"--data_dir\", \"/kaggle/input/datasets/shayanfazeli/heartbeat\",\n    \"--out_dir\", \"/kaggle/working/hasil_run3\",\n    \"--epochs\", \"100\",\n])\n    os.makedirs(args.out_dir, exist_ok=True)\n\n    np.random.seed(SEED); tf.random.set_seed(SEED)\n    X, y = make_synthetic() if args.smoke else load_data(args.data_dir)\n    print(\"Bentuk data:\", X.shape, \"| distribusi kelas:\")\n    dist = pd.Series(y).value_counts().sort_index()\n    dist.index = CLASS_NAMES\n    print(pd.DataFrame({\"jumlah\": dist, \"persen\": (dist / dist.sum() * 100).round(2)}))\n    dist.to_csv(os.path.join(args.out_dir, \"distribusi_kelas.csv\"))\n    # pemeriksaan kualitas data\n    print(\"Nilai hilang (NaN):\", int(np.isnan(X).sum()),\n          \"| min/max amplitudo:\", float(X.min()), float(X.max()))\n    print(\"Baris duplikat (fitur identik):\", int(pd.DataFrame(X).duplicated().sum()))\n\n    X_tr, X_va, X_te, y_tr, y_va, y_te = split_data(X, y)\n    print(\"train/val/test:\", len(X_tr), len(X_va), len(X_te))\n\n    # bobot kelas dihitung HANYA dari data latih: w_c = N / (K * n_c)\n    w = compute_class_weight(\"balanced\", classes=np.arange(5), y=y_tr)\n    class_weight = {i: float(v) for i, v in enumerate(w)}\n    print(\"class_weight:\", class_weight)\n\n    summaries, results = [], {}\n    for builder in (build_cnn, build_lstm):\n        model = builder()\n        model.summary()\n        hist, t_train = train_model(model, (X_tr, X_va, y_tr, y_va),\n                                    class_weight, args.epochs,\n                                    args.batch_size, args.out_dir)\n        plot_history(hist, model.name, args.out_dir)\n        s, pred, proba, cm = evaluate(model, X_te, y_te, args.out_dir)\n        s[\"train_time_s\"] = t_train\n        s[\"epochs_run\"] = len(hist[\"loss\"])\n        summaries.append(s)\n        results[model.name] = (pred, proba)\n        error_analysis(model.name, X_te, y_te, pred, proba, args.out_dir)\n        print(json.dumps(s, indent=2))\n\n    pd.DataFrame(summaries).to_csv(\n        os.path.join(args.out_dir, \"ringkasan_perbandingan.csv\"), index=False)\n\n    # F1 per kelas: CNN vs LSTM\n    f1c = f1_score(y_te, results[\"cnn1d\"][0], average=None, labels=range(5), zero_division=0)\n    f1l = f1_score(y_te, results[\"lstm\"][0], average=None, labels=range(5), zero_division=0)\n    fig, ax = plt.subplots(figsize=(6, 3.6))\n    xs = np.arange(5)\n    ax.bar(xs - 0.2, f1c, 0.4, label=\"1D-CNN\")\n    ax.bar(xs + 0.2, f1l, 0.4, label=\"LSTM\")\n    ax.set_xticks(xs); ax.set_xticklabels(CLASS_NAMES)\n    ax.set_ylabel(\"F1-score\"); ax.set_ylim(0, 1.05); ax.legend()\n    ax.set_title(\"F1-score per kelas (data uji)\")\n    fig.tight_layout()\n    fig.savefig(os.path.join(args.out_dir, \"fig_f1_per_kelas.png\"), dpi=200)\n    plt.close(fig)\n\n    # kasus saat CNN dan LSTM tidak sepakat (bahan error analysis)\n    pc, pl = results[\"cnn1d\"][0], results[\"lstm\"][0]\n    dis = pd.DataFrame({\"idx_test\": np.arange(len(y_te)),\n                        \"true\": [CLASS_NAMES[i] for i in y_te],\n                        \"pred_cnn\": [CLASS_NAMES[i] for i in pc],\n                        \"pred_lstm\": [CLASS_NAMES[i] for i in pl]})\n    dis[dis.pred_cnn != dis.pred_lstm].to_csv(\n        os.path.join(args.out_dir, \"cnn_lstm_berbeda_prediksi.csv\"), index=False)\n    print(\"Selesai. Semua keluaran ada di:\", args.out_dir)\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"_uuid":"b7e32ce7-cb86-4158-8df7-829c612b2a16","_cell_guid":"7682212a-d0f0-4d8d-9cc6-51606f425d13","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-10-27T14:50:14.636131Z","iopub.execute_input":"2026-10-27T14:50:14.636503Z","iopub.status.idle":"2026-10-27T14:58:48.940352Z","shell.execute_reply.started":"2026-10-27T14:50:14.63648Z","shell.execute_reply":"2026-10-27T14:58:48.939604Z"}},"outputs":[{"name":"stdout","text":"Bentuk data: (109446, 187) | distribusi kelas:\n   jumlah  persen\nN   90589   82.77\nS    2779    2.54\nV    7236    6.61\nF     803    0.73\nQ    8039    7.35\nNilai hilang (NaN): 0 | min/max amplitudo: 0.0 1.0\nBaris duplikat (fitur identik): 0\ntrain/val/test: 76612 16417 16417\nclass_weight: {0: 0.2416324985807103, 1: 7.873792394655704, 2: 3.025153010858835, 3: 27.264056939501778, 4: 2.723014039452639}\n","output_type":"stream"},{"name":"stderr","text":"WARNING: All log messages before absl::InitializeLog() is called are written to STDERR\nI0000 00:00:1793112651.284534      49 gpu_device.cc:2020] Created device /job:localhost/replica:0/task:0/device:GPU:0 with 13756 MB memory:  -> device: 0, name: Tesla T4, pci bus id: 0000:00:04.0, compute capability: 7.5\nI0000 00:00:1793112651.292153      49 gpu_device.cc:2020] Created device /job:localhost/replica:0/task:0/device:GPU:1 with 13756 MB memory:  -> device: 1, name: Tesla T4, pci bus id: 0000:00:05.0, compute capability: 7.5\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"\u001b[1mModel: \"cnn1d\"\u001b[0m\n","text/html":"<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\